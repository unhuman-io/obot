    </collision>
    <collision>   <!-- P23_Loop_Ring_J4_D4in -->
      <origin xyz="0.00314999 -2.69599e-05 0" rpy="0 1.570796 0"/>
      <geometry><cylinder radius="0.0508269" length="0.0317"/></geometry>
    </collision>
  </link>
  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_link"/><child link="tool_link"/>
    <origin xyz="0.0924 -0.0375 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.87979" upper="2.87979" effort="9" velocity="33.51"/>   <!-- J4: -165 .. 165 deg -->
  </joint>

  <link name="gripper_link">
    <inertial>
      <origin xyz="0.0297568 0 0" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.000268594" ixy="0" ixz="0" iyy="0.000267071" iyz="0" izz="0.000411367"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/gripper_link_alu.stl"/></geometry>
      <material name="alu"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/gripper_link_blk.stl"/></geometry>
      <material name="blk"/>
    </visual>
    <collision>   <!-- Gripper_TBD_Palm -->
      <origin xyz="0.019 0 0" rpy="0 0 0"/>
      <geometry><box size="0.038 0.08 0.05"/></geometry>
    </collision>
    <collision>   <!-- Gripper_TBD_Finger_L -->
      <origin xyz="0.069 -0.028 0" rpy="0 0 0"/>
      <geometry><box size="0.062 0.012 0.028"/></geometry>
    </collision>
    <collision>   <!-- Gripper_TBD_Finger_R -->
      <origin xyz="0.069 0.028 0" rpy="0 0 0"/>
      <geometry><box size="0.062 0.012 0.028"/></geometry>
    </collision>
  </link>
  <joint name="gripper_fixed_joint" type="fixed">
    <parent link="tool_link"/><child link="gripper_link"/>
    <origin xyz="0.0384 0 0" rpy="0 0 0"/>
  </joint>

  <link name="flange"/>   <!-- tool mounting face, on the roll axis, x out of the face -->
  <joint name="flange_joint" type="fixed">
    <parent link="tool_link"/><child link="flange"/>
    <origin xyz="0.0384 0 0" rpy="0 0 0"/>
  </joint>

  <link name="tool0"/>   <!-- the same point, z out of the face -->
  <joint name="tool0_joint" type="fixed">
    <parent link="flange"/><child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 1.570796 0"/>
  </joint>

  <link name="base_camera_link"/>   <!-- D435: centre of its front face, x = viewing direction (not the RealSense optical origin) -->
  <joint name="base_camera_link_joint" type="fixed">
    <parent link="base_link"/><child link="base_camera_link"/>
    <origin xyz="0.12 4.5e-05 0.01845" rpy="0 0 0"/>
  </joint>

  <link name="wrist_camera_link"/>   <!-- D435 on the roll housing: centre of its front face, x = viewing direction -->
  <joint name="wrist_camera_link_joint" type="fixed">
    <parent link="wrist_link"/><child link="wrist_camera_link"/>
    <origin xyz="0.0719 -0.037455 0.06385" rpy="0 0 0"/>
  </joint>
</robot>
